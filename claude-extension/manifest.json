{
  "manifest_version": "0.3",
  "name": "doop",
  "display_name": "Diazo",
  "version": "0.1.0",
  "description": "Design with Claude on a shared canvas. Create, edit and review designs together in real time.",
  "author": { "name": "Diazo", "url": "https://github.com/BRYANN2K/diazo" },
  "homepage": "https://github.com/BRYANN2K/diazo",
  "documentation": "https://github.com/BRYANN2K/diazo/tree/main/claude-extension",
  "support": "https://github.com/BRYANN2K/diazo/issues",
  "repository": { "type": "git", "url": "https://github.com/BRYANN2K/diazo" },
  "license": "AGPL-3.0-only",
  "icon": "icon.png",
  "server": {
    "type": "node",
    "entry_point": "node_modules/mcp-remote/dist/proxy.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/node_modules/mcp-remote/dist/proxy.js",
        "${user_config.server_url}",
        "--transport",
        "http-only",
        "--auth-timeout",
        "300",
        "--static-oauth-client-metadata",
        "{\"client_name\":\"Diazo for Claude Desktop\",\"client_uri\":\"https://github.com/BRYANN2K/diazo\"}"
      ]
    }
  },
  "user_config": {
    "server_url": {
      "type": "string",
      "title": "Diazo server URL",
      "description": "Your Diazo server's URL followed by /mcp. Keep this for a local install. HTTPS is required except on localhost.",
      "default": "http://localhost:4400/mcp",
      "required": true
    }
  },
  "compatibility": {
    "platforms": ["darwin", "win32"],
    "runtimes": { "node": ">=20.18.1" }
  },
  "tools_generated": true,
  "keywords": ["design", "canvas", "html", "css", "multiplayer"]
}
